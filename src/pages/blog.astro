---
// Blog list — rebuild of Elementor page 2663. Imported posts come from the blog collection
// (newest first); posts not imported yet are listed after them, as on the live site.
import Base from '../layouts/Base.astro';
import { getSortedPosts, legacyPosts, listExcerpt } from '../lib/posts';

const imported = (await getSortedPosts()).map((p) => ({
  href: `/${p.id}/`,
  img: p.data.featuredImage,
  alt: p.data.featuredImageAlt,
  title: p.data.title,
  excerpt: listExcerpt(p.data.excerpt),
}));
const posts = [...imported, ...legacyPosts];
---
<Base title="Blog -" description="MSP Marketing Academy">
  <section class="grad-hero mid">
    <div class="container">
      <div class="col">
        <div class="wrap">
          <div class="widget t-center"><h2 class="title">MSP Marketing Academy</h2></div>
        </div>
      </div>
    </div>
  </section>

  <section class="blog-list">
    <div class="container">
      <div class="col">
        <div class="wrap">
          <div class="widget">
            <div class="blog-posts">
              {posts.map((p) => (
                <article class="post">
                  <a class="post-thumb-link" href={p.href} tabindex="-1">
                    <div class="post-thumb"><img src={encodeURI(p.img)} alt={p.alt} width="750" height="500" loading="lazy" /></div>
                  </a>
                  <div class="post-text">
                    <h3 class="post-title"><a href={p.href}>{p.title}</a></h3>
                    <div class="post-excerpt"><p>{p.excerpt}</p></div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
