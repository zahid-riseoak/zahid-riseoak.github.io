---
// Single blog post — rebuild of the Elementor single-post template 524.
// Head tags are copied verbatim from the live post (see scripts/import-posts.mjs).
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { authorUrl, getSortedPosts, type Post } from '../lib/posts';
// After Base so these load after global.css and win ties.
import '@fontsource/varela-round';
import '@fontsource-variable/montserrat';
import '../styles/post.css';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // Elementor's post navigation: "Previous" is the older post, "Next" the newer one.
    props: { post, previous: posts[i + 1], next: posts[i - 1] },
  }));
}

interface Props {
  post: Post;
  previous?: Post;
  next?: Post;
}
const { post, previous, next } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const og = Object.entries(d.og).map(([k, v]) => [`og:${k.replace(/^image_/, 'image:')}`, v]);
const ogBefore = og.filter(([k]) => ['og:locale', 'og:type', 'og:title', 'og:description', 'og:url', 'og:site_name'].includes(k));
const ogImage = og.filter(([k]) => k === 'og:updated_time' || k.startsWith('og:image'));
const ogAfter = og.filter(([k]) => !ogBefore.some(([b]) => b === k) && !ogImage.some(([b]) => b === k));
const dateLabel = d.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title={d.metaTitle} description={d.metaDescription} robots={d.robots} customMeta>
  <Fragment slot="head">
    <link rel="canonical" href={d.canonical} />
    {ogBefore.map(([k, v]) => <meta property={k} content={v} />)}
    {d.article?.tags.map((t) => <meta property="article:tag" content={t} />)}
    {d.article?.section && <meta property="article:section" content={d.article.section} />}
    {ogImage.map(([k, v]) => <meta property={k} content={v} />)}
    {d.article?.published_time && <meta property="article:published_time" content={d.article.published_time} />}
    {d.article?.modified_time && <meta property="article:modified_time" content={d.article.modified_time} />}
    {ogAfter.map(([k, v]) => <meta property={k} content={v} />)}
    {Object.entries(d.twitter).map(([k, v]) => <meta name={`twitter:${k}`} content={v} />)}
  </Fragment>

  <article class="single-post">
    <header class="post-hero" style={`background-image:url('${d.featuredImage}')`}>
      <div class="post-hero-overlay" aria-hidden="true"></div>
      <div class="post-hero-inner">
        <h1 class="single-post-title">{d.title}</h1>
        <div class="post-author">
          <a class="post-author-link" href={authorUrl(d.author)}>
            {d.authorAvatar && <img src={d.authorAvatar} alt={`Picture of ${d.author}`} width="27" height="27" />}
            <span class="post-author-name">{d.author}</span>
          </a>
          <span class="post-meta-sep" aria-hidden="true">·</span>
          <time datetime={d.date.toISOString()}>{dateLabel}</time>
        </div>
      </div>
      {d.featuredImageAlt && <span class="sr-only" role="img" aria-label={d.featuredImageAlt}></span>}
    </header>

    <div class="post-main">
      <div class="post-body">
        <Content />
      </div>

      {(previous || next) && (
        <nav class="post-nav" aria-label="Post Navigation">
          <div class="post-nav-link prev">
            {previous && (
              <a href={`/${previous.id}/`} rel="prev">
                <span class="post-nav-arrow"><i class="fas fa-angle-left" aria-hidden="true"></i></span>
                <span class="post-nav-text">
                  <span class="post-nav-label">Previous</span>
                  <span class="post-nav-title">{previous.data.title}</span>
                </span>
              </a>
            )}
          </div>
          <div class="post-nav-sep" aria-hidden="true"></div>
          <div class="post-nav-link next">
            {next && (
              <a href={`/${next.id}/`} rel="next">
                <span class="post-nav-text">
                  <span class="post-nav-label">Next</span>
                  <span class="post-nav-title">{next.data.title}</span>
                </span>
                <span class="post-nav-arrow"><i class="fas fa-angle-right" aria-hidden="true"></i></span>
              </a>
            )}
          </div>
        </nav>
      )}
    </div>
  </article>
</Base>
