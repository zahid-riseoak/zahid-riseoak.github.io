---
// "Get Started in 4 Steps" block for the MSP and SaaS landing pages.
import { steps } from '../data/landing';

interface Props {
  ctaHref?: string;
}
const { ctaHref = '/consultation/' } = Astro.props;
---
<section class="ml-sec steps">
  <div class="ml-wrap">
    <h2 class="ml-h2">Get Started in 4 Steps</h2>
    <div class="container">
      {steps.map((s, i) => (
        <div class="col c25">
          <div class:list={['wrap step', { 'step-1': i === 0 }]}>
            <div class="widget image-box">
              <figure class="ib-img" style="margin-block:0;margin-inline:auto"><img src={s.img} alt={s.alt} width="100" height="100" loading="lazy" /></figure>
              <div class="ib-content">
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="ml-steps-cta"><a class="btn btn-primary" href={ctaHref}>Apply For Consultation</a></div>
  </div>
</section>
