---
// MSP landing page: RiseOak's live homepage copy, MSP only, in a form-led sales layout
// (hero + form card, service grid, alternating rows, testimonial cards, results, closing form).
import Base from '../layouts/Base.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import LeadForm from '../components/LeadForm.astro';
import LogoCarousel from '../components/LogoCarousel.astro';
import SalesCaseStudies from '../components/SalesCaseStudies.astro';
import SalesSteps from '../components/SalesSteps.astro';
import SalesTestimonials from '../components/SalesTestimonials.astro';
import { cardTestimonials, mspLogos, videoTestimonials } from '../data/landing';
import '../styles/sales-landing.css';

const painPoints = [
  "Don't know what really works for MSP marketing?",
  'Struggling to attract high-quality leads?',
  'Tired of spending on marketing but not seeing an ROI?',
  'Suffering from poor visibility on search engines?',
];

const services = [
  { icon: 'fa-paper-plane', title: 'Done-For-You Cold Email', text: 'We write, send, and manage cold email campaigns for your MSP.' },
  { icon: 'fa-globe', title: 'Websites especially for MSPs', text: 'Websites designed to address the unique needs and challenges of MSPs.' },
  { icon: 'fa-bahai', title: 'AI platform visibility', text: 'Increase visibility on ChatGPT and other AI answer platforms' },
  { icon: 'fa-map-marked-alt', title: 'Top search engine visibility', text: 'Boost organic traffic for industry-specific keywords that matter.' },
  { icon: 'fa-pen-alt', title: 'Authority content creation', text: 'Produce expert content that positions your MSP as an industry leader.' },
  { icon: 'fa-crown', title: 'Credibility from Inbound Links', text: "Elevate your site's authority by securing quality links from reputable sources." },
];

const reasons = [
  { lead: 'Proven Record with MSPs:', text: 'Our extensive track record with MSPs is backed by successful case studies.' },
  { lead: 'Transparent Reporting:', text: 'Gain complete insight with our custom reporting in text and video.' },
  { lead: 'Leading in AI and Tech:', text: 'We embrace cutting-edge tech for smarter, more effective campaigns.' },
];

const cases = [
  { href: '/proof-case-studies-powersolution/', title: '10x Traffic Growth and Multiple Contract Wins', img: '/images/2026/02/Powersolution-case-study-thumbnail-img-1.jpg', w: 750, h: 500 },
  { href: '/proof-case-studies-ntiva/', title: 'SEO Brings Two to Three New Clients a Month', img: '/images/2024/09/ssffsf-2.jpg', w: 750, h: 500 },
  { href: '/proof-case-studies-tcg-network-services/', title: 'SEO Speed Ranking', img: '/images/2024/09/ssffsf-5.jpg', w: 750, h: 500 },
];

const faqs = [
  { q: 'Will this work for my MSP?', a: 'If you are an MSP that is just getting started, we can help you set up your online presence. However, our process is best suited for MSPs that are somewhat established, with a proven track record and already investing in different forms of marketing.' },
  { q: 'How long does it take?', a: 'We have found that the more established your MSP is, the faster we can generate results for you. In most cases, we can show tangible results within the first two months.' },
  { q: 'What is you process? What will you do?', a: 'We begin by ensuring that your web presence is optimized to attract and convert prospects. We have found that many MSPs we work with do not have this foundation in place. Next, we increase the authority of your web presence to attract and convert local prospects who are searching for Managed IT Services.' },
];
---
<Base
  title="MSP Marketing Agency | RiseOak"
  description="Seeking a marketing agency for your MSP? Dive into our expert digital marketing solutions tailored for MSPs."
>
  <section class="ml-hero">
    <div class="ml-wrap ml-hero-grid">
      <div class="ml-hero-text">
        <h1>MSP Digital Marketing Agency for Exponential Growth</h1>
        <p>Harness the Power of AI and Data-Driven Marketing</p>
        <a class="btn btn-outline" href="/msp-ai-pilot/">Free AI Visibility Pilot</a>
      </div>
      <div class="ml-form-card e-form" id="apply">
        <h2>Apply For Consultation</h2>
        <LeadForm name="msp-landing-top" submitLabel="Apply For Consultation" />
      </div>
    </div>
  </section>

  <section class="ml-logos">
    <div class="ml-wrap">
      <h2 class="ml-logos-title">Some MSPs We've Helped</h2>
      <LogoCarousel slides={mspLogos} />
    </div>
  </section>

  <section class="ml-sec ml-intro">
    <div class="ml-wrap ml-narrow">
      <h2 class="ml-h2">Frustrated with options to grow your MSP online?</h2>
      <ul class="ml-checks">
        {painPoints.map((text) => (
          <li><i class="fas fa-check-circle" aria-hidden="true"></i><span>{text}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="ml-sec ml-services">
    <div class="ml-wrap">
      <h2 class="ml-h2">Leverage our specialized digital marketing solutions to drive revenue</h2>
      <div class="ml-service-grid">
        {services.map((s) => (
          <article class="ml-service">
            <div class="ml-service-icon"><i class={`fas ${s.icon}`} aria-hidden="true"></i></div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="reasons bg-tint">
    <div class="container">
      <div class="col">
        <div class="wrap">
          <div class="widget t-center"><h2 class="title sec-h2">Reasons We're Your Best Choice</h2></div>
          <div class="widget">
            <div class="container reasons-list">
              <div class="col">
                <div class="wrap">
                  <div class="widget">
                    <ul class="icon-list">
                      {reasons.map((r) => (
                        <li><span class="ico"><i class="fas fa-check-circle" aria-hidden="true"></i></span><span class="txt"><strong>{r.lead}</strong> {r.text}</span></li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SalesTestimonials heading="Results, Not Hype: We've Supported MSPs Like You" videos={videoTestimonials} cards={cardTestimonials} />

  <SalesCaseStudies cases={cases} />

  <SalesSteps ctaHref="#apply" />

  <section class="ml-band">
    <div class="ml-wrap">
      <h2>Get Ahead While Most MSPs Are Still Watching</h2>
      <a class="btn btn-outline" href="/msp-ai-visibility-roadmap/">Free AI Visibility Pilot</a>
    </div>
  </section>

  <section class="ml-sec faq bg-tint">
    <div class="ml-wrap ml-narrow">
      <h2 class="ml-h2">FAQs</h2>
      <FaqAccordion faqs={faqs} />
    </div>
  </section>
</Base>
