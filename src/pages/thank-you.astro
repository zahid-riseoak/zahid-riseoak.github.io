---
// Where Netlify Forms sends visitors after the consultation and AI Pilot forms submit.
import Base from '../layouts/Base.astro';
---
<Base title="Thank You | RiseOak" description="Thanks for reaching out to RiseOak." robots="noindex, follow">
  <section class="grad-hero legal mid">
    <div class="container">
      <div class="col">
        <div class="wrap">
          <div class="widget t-center"><h1 class="title">Thank You</h1></div>
        </div>
      </div>
    </div>
  </section>

  <section class="thanks-body">
    <div class="container">
      <div class="col">
        <div class="wrap center">
          <div class="widget t-center rich">
            <p>We’ve received your details. A member of the RiseOak team will be in touch shortly.</p>
          </div>
          <div class="widget t-center"><a class="btn btn-primary" href="/">Back to Homepage</a></div>
        </div>
      </div>
    </div>
  </section>
</Base>
