---
<LandingPage
  title="B2B SaaS Marketing Agency | RiseOak"
  description="Seeking a marketing agency for your B2B SaaS company? Dive into our expert digital marketing solutions tailored for B2B SaaS companies."
  h1="Digital Marketing Agency for B2B SaaS Companies"
  logosHeading="Some SaaS Companies We've Helped"
  logos={logos}
  painHeading="Frustrated with options to grow your SaaS company online?"
  painPoints={painPoints}
  services={services}
  reasons={reasons}
  aiCtaHeading="Get Ahead While Most SaaS Companies Are Still Watching"
  resultsHeading="Results, Not Hype: We've Supported SaaS Companies Like Yours"
  videoTestimonials={videoTestimonials}
  cardTestimonials={cardTestimonials}
  ctaSubject="SaaS company"
  faqs={faqs}
>
  <div slot="case-studies" class="saas-cases">
    {cases.map((c) => (
      <article class="saas-case">
        <img class={c.logoClass} src={c.logo} alt={c.alt} width={c.w} height={c.h} loading="lazy" />
        <h3>{c.title}</h3>
        <a class="btn btn-outline" href={c.href}>Read Case Study</a>
      </article>
    ))}
  </div>
</LandingPage>
