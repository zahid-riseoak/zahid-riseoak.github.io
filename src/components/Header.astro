---
// Elementor header 2521 (desktop + tablet/mobile bars) and popup 2517 (off-canvas menu).
interface NavItem {
  label: string;
  href?: string;
  children?: { label: string; href: string }[];
}
const nav: NavItem[] = [
  { label: 'Wins', href: '/wins/' },
  {
    label: 'Industries',
    children: [
      { label: 'MSP', href: '/msp-digital-marketing/' },
      { label: 'SaaS', href: '/saas-digital-marketing/' },
    ],
  },
  { label: 'About', href: '/about-us-msp/' },
];
const logo = '/images/2023/06/RiseOak-Logo.png';
---
<header class="site-header">
  <section class="hdr hdr-desktop">
    <div class="container">
      <div class="col logo-col">
        <div class="wrap">
          <div class="widget logo">
            <a href="/msp-marketing-agency/"><img src={logo} alt="RiseOak-Logo" width="400" height="107" /></a>
          </div>
        </div>
      </div>
      <div class="col nav-col">
        <div class="wrap">
          <nav class="widget main-nav" aria-label="Menu">
            <ul>
              {nav.map((item) => item.children ? (
                <li class="has-sub">
                  <button class="nav-parent" type="button" aria-expanded="false">{item.label}<i class="fas fa-caret-down" aria-hidden="true"></i></button>
                  <ul class="nav-sub">
                    {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
                  </ul>
                </li>
              ) : (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
          <div class="widget hdr-btn-wrap-1">
            <a class="btn btn-primary hdr-btn" href="/consultation/">Apply For Consultation</a>
          </div>
          <div class="widget hdr-btn-wrap-2">
            <a class="btn btn-outline hdr-btn" href="/msp-ai-pilot/">Free AI Visibility Pilot</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="hdr hdr-mobile">
    <div class="container">
      <div class="col">
        <div class="wrap">
          <div class="widget logo">
            <a href="/msp-marketing-agency/"><img src={logo} alt="RiseOak-Logo" width="400" height="107" /></a>
          </div>
        </div>
      </div>
      <div class="col toggle-col">
        <div class="wrap">
          <button class="menu-toggle" type="button" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false">
            <i class="fas fa-bars" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </div>
  </section>
</header>

<div class="popup" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="popup-panel">
    <button class="popup-close" type="button" aria-label="Close"><i class="eicon" aria-hidden="true">&#xe87f;</i></button>
    <div class="popup-body">
      <div class="popup-logo">
        <a href="/msp-marketing-agency/"><img src={logo} alt="RiseOak-Logo" width="400" height="107" /></a>
      </div>
      <div class="popup-links">
        <nav class="popup-nav" aria-label="Mobile menu">
          <ul>
            {nav.map((item) => item.children ? (
              <li>
                <span class="popup-parent">{item.label}</span>
                <ul class="popup-sub">
                  {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
                </ul>
              </li>
            ) : (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <div><a class="btn btn-primary" href="/apply-free-consultation/">Apply For Consultation</a></div>
        <div><a class="btn btn-outline" href="/msp-ai-pilot/">Free AI Visibility Pilot</a></div>
      </div>
    </div>
  </div>
</div>

<script>
  const popup = document.getElementById('mobile-menu')!;
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const setOpen = (open: boolean) => {
    popup.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle.addEventListener('click', () => setOpen(true));
  popup.querySelector('.popup-close')!.addEventListener('click', () => setOpen(false));
  popup.addEventListener('click', (e) => { if (e.target === popup) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

  // Desktop dropdowns open on hover via CSS; click covers touch screens and keyboards.
  const parents = document.querySelectorAll<HTMLButtonElement>('.nav-parent');
  const setSub = (btn: HTMLButtonElement, open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.parentElement!.classList.toggle('open', open);
  };
  parents.forEach((btn) => {
    btn.addEventListener('click', () => setSub(btn, btn.getAttribute('aria-expanded') !== 'true'));
  });
  document.addEventListener('click', (e) => {
    parents.forEach((btn) => { if (!btn.parentElement!.contains(e.target as Node)) setSub(btn, false); });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') parents.forEach((btn) => setSub(btn, false));
  });
</script>
