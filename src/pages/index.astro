---
// Homepage: B2B tech positioning. Layout lives in LandingPage.astro.
import LandingPage from '../components/LandingPage.astro';
import { cardTestimonials, saasCardTestimonials, saasVideoTestimonials, videoTestimonials } from '../data/landing';

const img = (p: string) => `/images/${p}`;

const logos = [
  { src: img('2023/09/Untitled-design-5.png'), label: 'Untitled design (5)' },
  { src: img('2024/06/Untitled-design-5.png'), label: 'CompassMSP logo' },
  { src: img('2026/04/powersolution-logo-1-1.png'), label: 'powersolution-logo-1-1' },
  { src: img('2023/09/MicroStrategy-Logo.png'), label: 'MicroStrategy Logo', fit: true },
  { src: img('2023/09/Untitled-design-6.png'), label: 'Untitled design (6)' },
  { src: img('2025/03/Katalyst-logo-1.png'), label: 'Katalyst logo' },
  { src: img('2023/09/Relatient.png'), label: 'Relatient', fit: true },
  { src: img('2023/09/Untitled-design-3.png'), label: 'Untitled design (3)' },
  { src: img('2023/12/Data-Tech-Logo.png'), label: 'Data-Tech Logo' },
  { src: img('2023/09/RoundTrip.png'), label: 'RoundTrip logo', fit: true },
  { src: img('2023/09/Untitled-design-7.png'), label: 'Untitled design (7)' },
  { src: img('2023/09/TravelBank-Logo.jpg'), label: 'TravelBank Logo', fit: true },
  { src: img('2023/09/Untitled-design-4.png'), label: 'Untitled design (4)' },
  { src: img('2023/09/Neuroflow.png'), label: 'Neuroflow', fit: true },
];

const painPoints = [
  "Don't know what really works for B2B tech marketing?",
  'Struggling to attract high-quality leads?',
  'Tired of spending on marketing but not seeing an ROI?',
  'Suffering from poor visibility on search engines?',
];

const services = [
  [
    { icon: 'fa-paper-plane', title: 'Done-For-You Cold Email', text: 'We write, send, and manage cold email campaigns for your business.' },
    { icon: 'fa-globe', title: 'Websites especially for B2B tech', text: 'Websites designed to address the unique needs and challenges of B2B tech companies.' },
    { icon: 'fa-bahai', title: 'AI platform visibility', text: 'Increase visibility on ChatGPT and other AI answer platforms' },
  ],
  [
    { icon: 'fa-map-marked-alt', title: 'Top search engine visibility', text: 'Boost organic traffic for industry-specific keywords that matter.' },
    { icon: 'fa-pen-alt', title: 'Authority content creation', text: 'Produce expert content that positions your company as an industry leader.' },
    { icon: 'fa-crown', title: 'Credibility from Inbound Links', text: "Elevate your site's authority by securing quality links from reputable sources." },
  ],
];

const reasons = [
  { lead: 'Proven Record with B2B Tech Solutions:', text: 'Our extensive track record with MSPs and other B2B tech companies is backed by successful case studies.' },
  { lead: 'Transparent Reporting:', text: 'Gain complete insight with our custom reporting in text and video.' },
  { lead: 'Leading in AI and Tech:', text: 'We embrace cutting-edge tech for smarter, more effective campaigns.' },
];

const faqs = [
  { q: 'Will this work for my company?', a: 'If your company is just getting started, we can help you set up your online presence. However, our process is best suited for companies that are somewhat established, with a proven track record and already investing in different forms of marketing.' },
  { q: 'How long does it take?', a: 'We have found that the more established your company is, the faster we can generate results for you. In most cases, we can show tangible results within the first two months.' },
  { q: 'Are there long term contracts?', a: 'No. We strongly believe that our ongoing relationship should be based on continuous results. All of our contracts are on a month-to-month basis.' },
  { q: 'What is you process? What will you do?', a: 'We begin by ensuring that your web presence is optimized to attract and convert prospects. We have found that many companies we work with do not have this foundation in place. Next, we increase the authority of your web presence to attract and convert prospects who are searching for your services.' },
];
---
<LandingPage
  title="B2B Tech Marketing Agency | RiseOak"
  description="Seeking a marketing agency for your B2B tech company? Dive into our expert digital marketing solutions tailored for B2B tech companies."
  h1="Digital Marketing Agency for B2B Tech Companies"
  industryLinks
  logosHeading="Some Companies We've Helped"
  logos={logos}
  painHeading="Frustrated with options to grow your company online?"
  painPoints={painPoints}
  services={services}
  reasons={reasons}
  aiCtaHeading="Get Ahead While Most Tech Companies Are Still Watching"
  resultsHeading="Results, Not Hype: We've Supported Companies Like Yours"
  videoTestimonials={[...videoTestimonials, ...saasVideoTestimonials]}
  cardTestimonials={[...cardTestimonials, ...saasCardTestimonials]}
  ctaSubject="tech company"
  faqs={faqs}
  academyHeading="Latest Thinking"
/>
